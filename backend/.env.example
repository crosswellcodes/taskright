# TaskRight backend — environment template. Copy to .env and fill in real values.
# Never commit .env (secrets). This template documents the required keys only.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=
API_BASE_URL=https://api.taskright.io
WEBSITE_URL=https://taskrightpro.com
MAPBOX_ACCESS_TOKEN=

# ── SMS provider selection (Twilio → SignalHouse migration) ────────────────────
# Primary selector + optional per-capability overrides for phased cutover.
# Each override defaults to SMS_PROVIDER when unset. Values: twilio | signalhouse
SMS_PROVIDER=twilio
# SMS_PROVIDER_SEND=
# SMS_PROVIDER_INBOUND=
# SMS_PROVIDER_PROVISION=
# SMS_PROVIDER_OTP=

# ── Twilio (current provider — retired at P6) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# TWILIO_PHONE_NUMBER is legacy/unused — each business has its own number.

# ── SignalHouse (new provider — populated during P2/P4 bootstrap) ─────────────
# 365-day service-user token (created once via the SignalHouse portal by the user).
SIGNALHOUSE_API_KEY=
SIGNALHOUSE_BASE_URL=https://v2.signalhouse.io
SIGNALHOUSE_GROUP_ID=
SIGNALHOUSE_WEBHOOK_SECRET=
# Dedicated TaskRight-owned number for pre-signup OTP (SignalHouse sends by number).
SIGNALHOUSE_OTP_SENDER=
